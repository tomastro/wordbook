{
  "manifest_version": 3,
  "name": "Word Collector",
  "version": "2.1",
  "permissions": [
    "contextMenus",
    "storage",
    "downloads",
    "identity"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "32": "icon.png",
    "64": "icon64.png"
  },
  "host_permissions": [
    "https://script.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}